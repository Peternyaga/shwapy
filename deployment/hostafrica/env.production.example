APP_NAME=Shwapy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shwapy.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=account_shwapy
DB_USERNAME=account_shwapy
DB_PASSWORD=
REMOVED_ROTATE_CREDENTIAL
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=shwapy.example.com

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@shwapy.example.com
MAIL_FROM_NAME="${APP_NAME}"

MPESA_ENV=live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://shwapy.example.com/api/payments/callback

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=8
GEMINI_FILE_TIMEOUT=15
GEMINI_CONNECT_TIMEOUT=2
GEMINI_MAX_FILE_BYTES=3145728
GEMINI_MOBILE_KEY_TTL=600
GEMINI_MOBILE_ENCRYPTION_SECRET=

GOOGLE_CLIENT_IDS=
